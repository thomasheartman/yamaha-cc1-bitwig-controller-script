#!/bin/sh
# ControlCenter launches plugins with a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin:
# /usr/local/bin) -- no /opt/homebrew/bin -- so "#!/usr/bin/env node" dies with exit 127
# and ControlCenter silently respawns it forever. Find node ourselves instead.
for node in /opt/homebrew/bin/node /usr/local/bin/node "$(command -v node 2>/dev/null)"; do
  [ -x "$node" ] && exec "$node" "$(dirname "$0")/bitwig.js" "$@"
done
echo "cc1 bridge: no node found" >&2
exit 127
